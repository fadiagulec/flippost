# ══════════════════════════════════════════════════════════════════════════
#  FlipIt — environment variables
# ══════════════════════════════════════════════════════════════════════════
#
#  These are NOT read from a file in production. Copy each value into your
#  hosting dashboard:
#
#    · Netlify  → Site configuration → Environment variables
#    · Railway  → your service → Variables
#
#  This file exists so you know what to set and why. Never commit real keys.
#
# ══════════════════════════════════════════════════════════════════════════


# ─── SET IN NETLIFY (the web app + API) ───────────────────────────────────

# REQUIRED. Powers every AI feature: viral score, script rewrite, prompts,
# niche ideas. Get one at https://console.anthropic.com → API keys.
# Without it, every AI button returns an error.
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED to sell. Verifies server-side that a Stripe checkout was really
# paid before granting Pro. Stripe → Developers → API keys → Secret key.
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_live_...

# REQUIRED to sell. Your Stripe Payment Link. The /get short URL redirects
# here, and every "Buy" button on the site points at /get — so this is the
# single place your checkout URL is defined.
# Stripe → Payment Links → create one → copy the URL.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxxxxxx

# REQUIRED. Random 64+ character string used to HMAC-sign Pro access tokens.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ⚠️  PICK ONCE, KEEP FOREVER. Changing it logs out every paying customer
#     and they will each have to re-verify from their receipt link.
FLIPIT_TOKEN_SECRET=

# STRONGLY RECOMMENDED. A long random secret only you know. It unlocks two
# owner-only powers:
#   1. Visit  https://your-site.com/unlock/<this-code>  to give yourself Pro
#      on any device, for free, without going through Stripe.
#   2. Log into /admin.html to revoke a refunded customer's access.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FLIPIT_CREATOR_CODE=

# OPTIONAL but recommended. Shown in rate-limit messages and error copy.
SUPPORT_EMAIL=support@your-domain.com

# OPTIONAL. Cosmetic labels used in server-generated messages. If unset they
# fall back to "FlipIt" and "$57".
BRAND_NAME=FlipIt
PRICE_LABEL=$57

# OPTIONAL. Base URL of your own deployed /backend service (see below).
# Leave unset and the app still works — you just lose transcription, scene
# extraction, the watermark eraser and the yt-dlp download path.
RAILWAY_URL=https://your-backend.up.railway.app

# OPTIONAL. A Cobalt API instance used as a download fallback. Leave unset
# to skip that path; other download routes still work.
COBALT_URL=

# OPTIONAL. Extra origins allowed to call your API, comma-separated.
# Netlify already sets URL automatically, so your own site works with no
# config. Use this for a staging domain or a second brand.
ALLOWED_ORIGINS=

# OPTIONAL. Overrides Netlify's automatic URL. Only needed if the app is
# served from a domain that differs from your Netlify primary URL.
SITE_URL=

# OPTIONAL. Tune the free tier and the Pro fair-use ceilings without
# touching code. Defaults shown.
FREE_DAILY_LIMIT=3
PRO_DAILY_LIMIT=50
PRO_MONTHLY_LIMIT=1000

# OPTIONAL. POST every server error to this webhook (Slack, Discord,
# Zapier…) so you hear about breakage before customers email you.
ERROR_WEBHOOK_URL=


# ─── SET ON YOUR BACKEND HOST (Railway / Render / Fly.io) ─────────────────

# REQUIRED for transcription. Whisper API key from https://platform.openai.com
# Without it, the Transcribe feature returns a clear "not configured" error;
# everything else still works.
OPENAI_API_KEY=sk-...

# OPTIONAL. Base64-encoded Instagram cookies.txt, which lets yt-dlp fetch
# Instagram videos that require a logged-in session. Without it, most public
# Instagram content still resolves through the other download paths.
#   Export cookies.txt with a browser extension, then:
#   base64 -w0 cookies.txt
INSTAGRAM_COOKIES_B64=


# ─── SET IN GITHUB (optional) ─────────────────────────────────────────────

# Repo → Settings → Secrets and variables → Actions → New repository secret.
# A Netlify build hook URL. The included workflow pings it on every push to
# main, as a backup for when Netlify's own GitHub integration misfires.
# Netlify → Site configuration → Build & deploy → Build hooks → Add.
NETLIFY_BUILD_HOOK=
